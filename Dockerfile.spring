FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /workspace
COPY pom.xml ./
COPY football-common ./football-common
COPY football-gateway ./football-gateway
COPY football-user-service ./football-user-service
COPY football-business-service ./football-business-service

ARG MODULE
RUN mvn -pl ${MODULE} -am clean package spring-boot:repackage \
    && mkdir -p /workspace/build-output \
    && cp /workspace/${MODULE}/target/${MODULE}-*.jar /workspace/build-output/app.jar

FROM eclipse-temurin:17-jre-jammy

WORKDIR /app
COPY --from=builder /workspace/build-output/app.jar /app/app.jar

# 生产容器不以 root 运行，避免应用漏洞直接获得容器管理权限。
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin football \
    && chown -R football:football /app
USER 10001

ENV JAVA_OPTS="-Xms256m -Xmx512m"
ENV SPRING_PROFILES_ACTIVE=prod

EXPOSE 8082 9000 9001

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
