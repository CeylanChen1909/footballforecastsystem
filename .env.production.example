# 复制为服务器项目根目录的 .env，禁止提交真实值。
# docker-compose.prod.yml 会读取这个文件中的变量。

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DB=football_forecast
MYSQL_USER=football_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password

REDIS_PASSWORD=replace-with-a-long-random-redis-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
ML_INTERNAL_TOKEN=replace-with-a-separate-long-random-ml-token

# 生产域名，不要填 localhost。
GATEWAY_CORS_ALLOWED_ORIGINS=https://your-domain.example
GATEWAY_TRUST_PROXY_HEADERS=false

# 邮箱验证码
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_CONSOLE_MODE=false

# 模型与 Agent（按实际启用的供应商填写）
SCNET_API_KEY=replace-with-scnet-api-key
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1
SCNET_MODEL=GLM-5-Base
SCNET_MODELS=GLM-5-Base
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# 数据源
CRAWLER_PRIMARY_ONLY=true
CRAWLER_PRIMARY_SOURCE=bbc-scores
API_FOOTBALL_API_KEY=
JUHE_FOOTBALL_API_KEY=
UNDERSTAT_ENRICHMENT_ENABLED=true
PYTHON_INFERENCE_ENABLED=true
