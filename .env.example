# 复制为 .env 后填写，禁止把真实密码提交到 Git
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=football_forecast
MYSQL_USER=root
MYSQL_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
NACOS_ADDR=127.0.0.1:8848
JWT_SECRET=replace-with-a-long-random-secret
ML_INTERNAL_TOKEN=replace-with-a-separate-long-random-token
ML_REQUIRE_INTERNAL_AUTH=true
ML_MAX_REQUEST_BYTES=65536
AUTH_RATE_LIMIT_FAIL_CLOSED=true
SECURITY_REFRESH_TOKEN_COOKIE_ONLY=true
# 只有部署在可信反向代理之后才设为 true
GATEWAY_TRUST_PROXY_HEADERS=false
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
APP_RUNTIME_DDL_ENABLED=false
APP_SCHEMA_REQUIRE_MIGRATIONS=true
APP_SCHEMA_REQUIRED_TABLES=t_user,crawler_matches,t_match_prediction,t_prematch_feature_snapshot,t_agent_conversation,t_analytics_event

# SMTP 发件邮箱（推荐使用专用邮箱和应用专用密码/授权码）
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-smtp-password-or-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_CONSOLE_MODE=false
AGENT_DAILY_TOKEN_BUDGET=20000

# 比赛采集暂时只使用主爬虫源，避免多源重复写入
CRAWLER_PRIMARY_ONLY=true
CRAWLER_PRIMARY_SOURCE=bbc-scores

# Card Lab 默认只开放虚拟角色卡；真实球员卡需完成授权、统计和评分校准后再开启
CARD_WORKSHOP_REAL_PLAYERS_ENABLED=false
CARD_WORKSHOP_ENABLED=false
CARD_ROGUE_ENABLED=false

# 赛前历史样本缓存（来自 football-data 的本地训练缓存，仅读）
HISTORICAL_MATCH_CACHE_PATH=football-ml-service/data_cache

# 赛前特征与 API-Football 详情回填（仅对带 API-Football fixture_id 的比赛请求）
PREMATCH_ENRICHMENT_FIXED_DELAY_MS=900000
PREMATCH_DETAILS_ENABLED=true
PREMATCH_DETAILS_INITIAL_DELAY_MS=30000
PREMATCH_DETAILS_FIXED_DELAY_MS=1800000
PREMATCH_DETAILS_MAX_FIXTURES_PER_RUN=18
PREMATCH_DETAILS_MAX_HISTORICAL_PER_RUN=5
PREMATCH_DETAILS_MAX_PRIMARY_PER_RUN=12
PREMATCH_DETAILS_MAX_PRIMARY_HISTORICAL_PER_RUN=5
API_FOOTBALL_MAX_DAILY_REQUESTS=90

# Agent 模型通道（密钥只放本地 .env，不要提交真实值）
SCNET_API_KEY=replace-with-scnet-api-key
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1
SCNET_MODEL=GLM-5-Base
SCNET_MODELS=GLM-5-Base

# 新训练会生成滚动排名/状态/赛程密度特征；xG/射门等无供应商数据时按缺失审计，不伪造
USE_OPTIONAL_PREMATCH_FEATURES=false
# Understat 公开历史 xG/xGA 增强（仅作训练特征，不替代主赛程源）。响应会写入
# football-ml-service/data_cache/，默认缓存 30 天；match detail 每赛季最多抓取 4 场，避免过度请求。
UNDERSTAT_ENRICHMENT_ENABLED=true
UNDERSTAT_CACHE_TTL_HOURS=720
UNDERSTAT_REQUEST_SLEEP_SECONDS=0.15
UNDERSTAT_MATCH_DETAIL_LIMIT=4
# 业务服务运行时 xG 导入（仅读 Understat 公开赛季数据，失败自动降级）
UNDERSTAT_BASE_URL=https://understat.com
UNDERSTAT_SEASONS=2020,2021,2022,2023,2024,2025
UNDERSTAT_TIMEOUT_MS=15000
UNDERSTAT_MAX_REQUESTS_PER_RUN=15
UNDERSTAT_MAX_ROWS_PER_SEASON=1200
UNDERSTAT_INITIAL_DELAY_MS=120000
UNDERSTAT_FIXED_DELAY_MS=21600000
# Data quality audit is read-only against crawler_matches and refreshes every 30 minutes.
DATA_QUALITY_INITIAL_DELAY_MS=150000
DATA_QUALITY_FIXED_DELAY_MS=1800000
# Optional CatBoost challenger during offline training. It never bypasses the
# existing candidate/promotion gate and is skipped when the package is absent.
ENABLE_CATBOOST_CANDIDATE=true
